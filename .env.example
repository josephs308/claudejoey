# ---- Claude (Anthropic) ----
ANTHROPIC_API_KEY=sk-ant-...
# Most capable default. For high reply volume, claude-sonnet-4-6 is cheaper/faster.
CLAUDE_MODEL=claude-opus-4-8

# ---- Instantly ----
INSTANTLY_API_KEY=your-instantly-v2-api-key
INSTANTLY_BASE_URL=https://api.instantly.ai/api/v2

# ---- Webhook security ----
# Set the same value in your Instantly webhook config (sent as ?secret=... or
# the x-webhook-secret header). Leave blank to skip verification (dev only).
INSTANTLY_WEBHOOK_SECRET=

# ---- Approval API security ----
# Any random string. Required as `Authorization: Bearer <token>` on /drafts routes.
APPROVAL_API_TOKEN=change-me

# ---- Server ----
PORT=3000
DATA_DIR=./data
