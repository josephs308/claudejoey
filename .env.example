# ---------------------------------------------------------------------------
# Lawmatics -> Eve connector
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# --- Lawmatics inbound webhooks --------------------------------------------
# From Lawmatics: Settings -> Integrations -> Webhooks. Starts with "whsec_".
LAWMATICS_WEBHOOK_SECRET=whsec_replace_me
# Reject deliveries signed more than this many seconds ago (replay protection).
LAWMATICS_WEBHOOK_TOLERANCE_SECONDS=300

# --- Lawmatics REST API (OAuth2 authorization-code flow) --------------------
LAWMATICS_API_BASE_URL=https://api.lawmatics.com
LAWMATICS_CLIENT_ID=
LAWMATICS_CLIENT_SECRET=
# Obtained once by completing the OAuth authorization-code flow.
LAWMATICS_REFRESH_TOKEN=
# Local testing shortcut; leave blank in production and use the OAuth values.
LAWMATICS_ACCESS_TOKEN=

# --- Conversion rule --------------------------------------------------------
# Matter statuses that mean "this lead is now a client". Case-insensitive.
# Set these to the firm's actual status names in Lawmatics.
CONVERSION_STATUSES=hired,signed,client,retained,converted
# Optional: sub-statuses that must never sync even when the status matches.
CONVERSION_EXCLUDED_SUBSTATUSES=

# --- Eve --------------------------------------------------------------------
# mock = log the payload only (safe default). http = deliver to Eve for real.
EVE_MODE=mock
EVE_API_BASE_URL=
EVE_CREATE_CLIENT_PATH=/v1/clients
# bearer | header | basic
EVE_AUTH_SCHEME=bearer
EVE_API_KEY=
# Only used when EVE_AUTH_SCHEME=header.
EVE_API_KEY_HEADER=X-Api-Key
EVE_FIRM_ID=
EVE_TIMEOUT_MS=15000

# --- Delivery ---------------------------------------------------------------
QUEUE_MAX_ATTEMPTS=6
QUEUE_BASE_DELAY_MS=1000
QUEUE_MAX_DELAY_MS=60000
STATE_DIR=./data
